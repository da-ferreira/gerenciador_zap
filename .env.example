PORT=3090

# Senha única de acesso à tela
APP_PASSWORD=
# Segredo que assina o cookie de sessão (string longa aleatória)
SESSION_SECRET=
# 1 quando estiver atrás de HTTPS (cookie só trafega em HTTPS)
COOKIE_SECURE=0
# 1 quando estiver atrás de proxy reverso (nginx), para o IP real no bloqueio de login
TRUST_PROXY=0

# apiLoopiee do Chat Ativo (na .101 roda como apiMidiaHub, porta 3535), alcançado pela VPN.
LOOPIEE_API_URL=http://192.168.10.101:3535
LOOPIEE_USERNAME=
LOOPIEE_PASSWORD=

# Arquivo onde ficam campanhas, bases e remoções (padrão: data/db.json)
DATA_FILE=
